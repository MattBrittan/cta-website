{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cta-contact",
  "main": "src/index.js",
  "account_id": "414d77685b8ac23bf8e62fe206b6e40e",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "secrets": { "required": ["TURNSTILE_SECRET_KEY"] },
  "vars": {
    "CONTACT_ENABLED": "true",
    "CONTACT_TO": "trapping@craigieburn.nz",
    "CONTACT_FROM": "website@craigieburn.nz",
    "ALLOWED_ORIGINS": "https://craigieburn.nz,https://www.craigieburn.nz,https://craigieburntrapping.nz,https://www.craigieburntrapping.nz,https://craigieburn-trapping.pages.dev"
  },
  "send_email": [{ "name": "CONTACT_EMAIL", "destination_address": "trapping@craigieburn.nz" }],
  "ratelimits": [{ "name": "CONTACT_LIMIT", "namespace_id": "2026091001", "simple": { "limit": 5, "period": 60 } }],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
