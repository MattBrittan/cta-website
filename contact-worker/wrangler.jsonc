{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cta-contact",
  "main": "src/index.js",
  "account_id": "dc873fa1bd89cf800aedb7e5b4e6cda5",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "secrets": {
    "required": [
      "TURNSTILE_SECRET_KEY"
    ]
  },
  "vars": {
    "CONTACT_ENABLED": "true",
    "CONTACT_TO": "craigieburntrapping@gmail.com",
    "CONTACT_FROM": "website@craigieburn.nz",
    "ALLOWED_ORIGINS": "https://craigieburn.nz,https://www.craigieburn.nz,https://craigieburntrapping.nz,https://www.craigieburntrapping.nz,https://craigieburn-trapping-7pd.pages.dev"
  },
  "send_email": [
    {
      "name": "CONTACT_EMAIL",
      "destination_address": "craigieburntrapping@gmail.com"
    }
  ],
  "ratelimits": [
    {
      "name": "CONTACT_LIMIT",
      "namespace_id": "2026091001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
